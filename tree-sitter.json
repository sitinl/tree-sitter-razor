{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "razor",
      "camelcase": "Razor",
      "title": "ASP.NET Razor",
      "scope": "text.html.razor",
      "file-types": [
        "cshtml"
      ],
      "injection-regex": "^razor$",
      "class-name": "TreeSitterRazor"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for ASP.NET Razor (.cshtml)",
    "authors": [
      {
        "name": "k-hayashi",
        "email": "sitinl@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-razor",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}